{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziwei-ai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "ALLOWED_ORIGINS": "https://ziwei-doushu-5xd.pages.dev,https://wdyziweidoushu666.com"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
