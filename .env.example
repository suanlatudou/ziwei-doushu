# 复制为 .env.local 后填入实际值

# ─── AI Worker ───
# 生产环境填写你的 Cloudflare Worker 地址
NEXT_PUBLIC_AI_API_URL=https://ziwei-ai-api.730333227.workers.dev/api/interpret

# ─── 爱发电自动到账（必须是完整 /order/create 地址）───
NEXT_PUBLIC_AFDIAN_CHECKOUT_1=
NEXT_PUBLIC_AFDIAN_CHECKOUT_3=
NEXT_PUBLIC_AFDIAN_CHECKOUT_10=

# ─── AI 推理（服务端/Worker 使用）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
